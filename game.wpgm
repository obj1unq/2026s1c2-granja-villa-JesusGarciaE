import wollok.game.*
import personaje.*
import cultivos.*
import direcciones.*

program farmville {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("ground.png")

	//keyboard
	keyboard.w().onPressDo({personaje.mover(arriba)})
	keyboard.a().onPressDo({personaje.mover(izquierda)})	
	keyboard.s().onPressDo({personaje.mover(abajo)})
	keyboard.d().onPressDo({personaje.mover(derecha)})
	keyboard.m().onPressDo({personaje.sembrarMaiz()})
	keyboard.t().onPressDo({personaje.sembrarTrigo()})
	keyboard.o().onPressDo({personaje.sembrarTomaco()})
	//keyboard.r().onPressDo({personaje.regar(cultivo)})
	// //  VISUALES
 	game.addVisualCharacter(personaje)
 	// game.addVisual(new Maiz()) // Se agrega a modo de prueba
 	// game.addVisual(new Tomaco())
	// game.addVisual(new Trigo())
 	// //  COMIENZA
	game.start()
}
